[Unit]
Description=Home network monitor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/NetworkScanner
EnvironmentFile=-/etc/default/netscan
ExecStart=/opt/NetworkScanner/.venv/bin/gunicorn --bind 127.0.0.1:5000 --workers 1 --threads 4 --timeout 180 main:scanner
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
